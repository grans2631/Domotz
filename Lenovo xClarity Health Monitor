/* =========================================================
 * TEMPERATURE HELPERS
 * ======================================================= */

function parseThreshold(value) {

    if (
        value === null ||
        value === undefined
    ) {

        return null;
    }


    var number =
        parseFloat(
            String(value)
        );


    if (
        isNaN(number)
    ) {

        return null;
    }


    return number;
}


function determineTemperatureHealth(
    currentC,
    warning,
    softShutdown,
    hardShutdown
) {

    if (
        currentC === null
    ) {

        return 'Not Reported';
    }


    var warn =
        parseThreshold(
            warning
        );


    var soft =
        parseThreshold(
            softShutdown
        );


    var hard =
        parseThreshold(
            hardShutdown
        );


    if (
        hard !== null &&
        currentC >= hard
    ) {

        return 'Critical';
    }


    if (
        soft !== null &&
        currentC >= soft
    ) {

        return 'Critical';
    }


    if (
        warn !== null &&
        currentC >= warn
    ) {

        return 'Warning';
    }


    if (
        warn !== null ||
        soft !== null ||
        hard !== null
    ) {

        return 'OK';
    }


    return 'Not Reported';
}


/* =========================================================
 * TEMPERATURE PARSER
 * ======================================================= */

function parseTemperatures(
    output,
    state
) {

    logRaw(
        'TEMPERATURES',
        output
    );


    if (
        outputContainsCommandError(
            output
        )
    ) {

        log(
            'Temperature command unsupported'
        );


        state.collectionProblemCount++;


        return;
    }


    var lines =
        getLines(
            output
        );


    var rowIndex = 0;


    for (
        var i = 3;
        i < lines.length;
        i++
    ) {

        var line =
            lines[i].trim();


        if (
            isSeparatorLine(
                line
            )
        ) {

            continue;
        }


        var parts =
            line.split(
                /\s+/
            );


        if (
            parts.length < 6
        ) {

            continue;
        }


        var warningReset =
            parts[
                parts.length - 5
            ];


        var warning =
            parts[
                parts.length - 4
            ];


        var temperatureText =
            parts[
                parts.length - 3
            ];


        var softShutdown =
            parts[
                parts.length - 2
            ];


        var hardShutdown =
            parts[
                parts.length - 1
            ];


        var temperatures =
            String(
                temperatureText
            ).split(
                '/'
            );


        if (
            temperatures.length < 2
        ) {

            continue;
        }


        var temperatureF =
            safeNumber(
                temperatures[0],
                null
            );


        var temperatureC =
            safeNumber(
                temperatures[1],
                null
            );


        if (
            temperatureF === null ||
            temperatureC === null
        ) {

            continue;
        }


        var component =
            parts
                .slice(
                    0,
                    parts.length - 5
                )
                .join(
                    ' '
                );


        if (
            component === ''
        ) {

            continue;
        }


        var health =
            determineTemperatureHealth(
                temperatureC,
                warning,
                softShutdown,
                hardShutdown
            );


        rowIndex++;


        if (
            state.highestTemperatureC === null ||
            temperatureC >
            state.highestTemperatureC
        ) {

            state.highestTemperatureC =
                temperatureC;
        }


        applyHealth(
            state,
            'Temperature',
            health
        );


        addHardwareRow(
            '07-temperature',
            rowIndex,
            'Temperature',
            component,
            health,

            temperatureC +
            ' C / ' +
            temperatureF +
            ' F',

            'Temperature Sensor',

            joinDetails(
                [
                    'Warning Reset: ' +
                    warningReset,

                    'Warning: ' +
                    warning,

                    'Soft Shutdown: ' +
                    softShutdown,

                    'Hard Shutdown: ' +
                    hardShutdown
                ]
            )
        );
    }


    if (
        rowIndex === 0
    ) {

        log(
            'Temperature parser found no sensor rows'
        );


        state.collectionProblemCount++;
    }
}


