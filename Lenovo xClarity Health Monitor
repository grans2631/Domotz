/* =========================================================
 * TERMINAL FAILURE
 * ======================================================= */

function terminalFailure(error) {

    var errorType =
        error &&
        error.type
            ? error.type
            : D.errorType.GENERIC_ERROR;


    if (
        error &&
        error.message
    ) {

        console.error(
            '[XCLARITY] ' +
            error.message
        );
    }


    return D.failure(
        errorType
    );
}


/* =========================================================
 * VALIDATION
 * ======================================================= */

/**
 * @remote_procedure
 * @label Validate Lenovo XClarity
 * @documentation Validates Lenovo XClarity SSH authentication and syshealth summary command execution.
 */
function validate() {

    log(
        '================================'
    );


    log(
        'Starting XClarity validation'
    );


    executeCommand(
        'syshealth summary'
    )

    .then(
        function(output) {

            if (
                !output ||
                String(output).trim() === ''
            ) {

                var empty =
                    D.q.defer();


                empty.reject(
                    makeError(
                        D.errorType.PARSING_ERROR,

                        'syshealth summary returned no output'
                    )
                );


                return empty.promise;
            }


            if (
                outputContainsCommandError(
                    output
                )
            ) {

                var unsupported =
                    D.q.defer();


                unsupported.reject(
                    makeError(
                        D.errorType.PARSING_ERROR,

                        'syshealth summary is not supported by this device'
                    )
                );


                return unsupported.promise;
            }


            log(
                'Validation successful'
            );


            return D.success();
        }
    )

    .catch(
        function(error) {

            return terminalFailure(
                error
            );
        }
    );
}


